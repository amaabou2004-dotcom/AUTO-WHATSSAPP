# Authentification — valeurs obligatoires en production.
# En développement local, admin@demo.local / demo1234 sont utilisés automatiquement.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=
AUTH_SESSION_HOURS=12

# Laisser vide pour utiliser le mode démo WhatsApp (aucun message réel n'est envoyé).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=changez-ce-token-de-verification
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0

# Optionnel — backend
PORT=3000
# DATA_FILE=/chemin/vers/store.json
# Domaines autorisés à appeler l’API, séparés par des virgules (CORS).
# FRONTEND_URL=https://votre-site.netlify.app

# Optionnel — frontend, uniquement si l’API est sur un autre domaine.
# Cette valeur est intégrée au build Netlify et ne doit contenir aucun secret.
# VITE_API_URL=https://votre-backend-public.example/api
