# ---------------------------------------------------------------------------
# Variables d'environnement — copier en .env (JAMAIS commité).
# Aucune valeur réelle ne doit apparaître dans ce fichier.
# ---------------------------------------------------------------------------

# --- Application ---
NODE_ENV=development
APP_VERSION=0.0.0

# --- API Worker ---
# Base URL utilisée par le frontend (vide = chemin relatif /api/v1)
VITE_API_BASE_URL=/api/v1
# CORS : origines autorisées, séparées par des virgules
API_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de données (Phase 6) ---
# Connexion directe Postgres de l'API Worker (pooler Supabase)
DATABASE_URL=
# Connexion service (migrations, jobs système). NE JAMAIS exposer au frontend.
DATABASE_URL_SERVICE=

# --- Supabase (Phase 5) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Chiffrement des jetons WhatsApp (Phase 8) ---
# Clé de 32 octets encodée en base64. Générer : openssl rand -base64 32
SECRETS_KEK_BASE64=
SECRETS_KEK_KEY_ID=

# --- Meta / WhatsApp (Phase 8) ---
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

# --- Fournisseurs IA (Phase 9) ---
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=

# --- Facturation (Phase 12) ---
BILLING_PROVIDER=manual
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
