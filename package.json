{
  "name": "whatsauto-ai",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml,css}\"",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "openapi:validate": "bash scripts/validate-openapi.sh",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
