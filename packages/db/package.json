{
  "name": "@whatsauto/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "migrate": "pnpm build && node dist/node/migrate-cli.js"
  },
  "dependencies": {
    "kysely": "^0.29.7",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
